@model CategoriaFormViewModel

@{
    var accion = ViewData["FormAction"] as string ?? "Create";
    var textoBoton = ViewData["SubmitLabel"] as string ?? "Guardar categoría";
}

<div class="mx-auto max-w-xl">
    <div class="mb-6">
        <a asp-action="Index" class="text-sm font-medium text-brand-600 transition hover:text-brand-700">← Volver a categorías</a>
        <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-900">@ViewData["Title"]</h1>
    </div>

    <form asp-action="@accion" method="post" class="space-y-5 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly"></div>

        <div>
            <label asp-for="Nombre" class="label"></label>
            <input asp-for="Nombre" class="input-field" placeholder="Ej. Tecnología" />
            <span asp-validation-for="Nombre"></span>
        </div>

        <div>
            <label asp-for="Descripcion" class="label"></label>
            <textarea asp-for="Descripcion" rows="3" class="input-field"
                      placeholder="Describe qué productos pertenecen a esta categoría"></textarea>
            <span asp-validation-for="Descripcion"></span>
        </div>

        <div class="flex flex-wrap gap-3 border-t border-slate-100 pt-5">
            <button type="submit" class="btn-primary">@textoBoton</button>
            <a asp-action="Index" class="btn-secondary">Cancelar</a>
        </div>
    </form>
</div>
