@model CategoriaDeleteViewModel

@{
    ViewData["Title"] = "Eliminar categoría";
    var bloqueada = Model.ProductosCount > 0 || Model.Id == 1;
}

<div class="mx-auto max-w-2xl">
    <div class="rounded-2xl border border-red-200 bg-white p-6 shadow-sm sm:p-8">
        <p class="text-sm font-semibold uppercase tracking-wide text-red-600">Eliminar categoría</p>
        <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-900">@Model.Nombre</h1>

        @if (Model.Id == 1)
        {
            <p class="mt-4 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-800 ring-1 ring-inset ring-amber-200">
                La categoría <strong>General</strong> es la predeterminada y no se puede eliminar.
            </p>
        }
        else if (Model.ProductosCount > 0)
        {
            <p class="mt-4 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-800 ring-1 ring-inset ring-amber-200">
                No se puede eliminar porque tiene <strong>@Model.ProductosCount producto(s)</strong> asociado(s).
                Reasígnalos a otra categoría primero.
            </p>
            <a asp-controller="Productos" asp-action="Index" asp-route-categoriaId="@Model.Id" class="btn-secondary mt-4">
                Ver productos de esta categoría
            </a>
        }
        else
        {
            <p class="mt-4 text-sm text-slate-600">Esta acción no se puede deshacer.</p>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
        {
            <p class="mt-4 text-sm text-slate-500">@Model.Descripcion</p>
        }

        @if (!bloqueada)
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-6 flex flex-wrap gap-3">
                <button type="submit" class="inline-flex items-center justify-center rounded-lg bg-red-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-red-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600">
                    Sí, eliminar
                </button>
                <a asp-action="Index" class="btn-secondary">Cancelar</a>
            </form>
        }
        else
        {
            <a asp-action="Index" class="btn-secondary mt-6">Volver a categorías</a>
        }
    </div>
</div>
