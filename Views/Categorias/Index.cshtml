@model CategoriaIndexViewModel

@{
    ViewData["Title"] = "Categorías";
}

<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Categorías</h1>
        <p class="mt-1 text-sm text-slate-500">Agrupa los productos del catálogo.</p>
    </div>
    <a asp-action="Create" class="btn-primary">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Nueva categoría
    </a>
</div>

@if (Model.Categorias.Count == 0)
{
    <div class="mt-6 rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center">
        <p class="text-sm font-semibold text-slate-900">Todavía no hay categorías</p>
        <p class="mt-1 text-sm text-slate-500">Crea la primera para poder clasificar productos.</p>
        <a asp-action="Create" class="btn-primary mt-5">Crear categoría</a>
    </div>
}
else
{
    <div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
                <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500">
                    <tr>
                        <th scope="col" class="px-4 py-3 sm:px-6">Nombre</th>
                        <th scope="col" class="px-4 py-3 sm:px-6">Descripción</th>
                        <th scope="col" class="px-4 py-3 text-right sm:px-6">Productos</th>
                        <th scope="col" class="px-4 py-3 text-right sm:px-6">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var categoria in Model.Categorias)
                    {
                        <tr class="transition hover:bg-slate-50">
                            <td class="px-4 py-3 font-medium text-slate-900 sm:px-6">
                                @categoria.Nombre
                                @if (categoria.Id == 1)
                                {
                                    <span class="badge ml-2">Predeterminada</span>
                                }
                            </td>
                            <td class="max-w-md px-4 py-3 text-slate-500 sm:px-6">
                                @(string.IsNullOrWhiteSpace(categoria.Descripcion) ? "—" : categoria.Descripcion)
                            </td>
                            <td class="whitespace-nowrap px-4 py-3 text-right sm:px-6">
                                <a asp-controller="Productos" asp-action="Index" asp-route-categoriaId="@categoria.Id"
                                   class="font-semibold text-brand-600 transition hover:text-brand-700">
                                    @categoria.ProductosCount
                                </a>
                            </td>
                            <td class="whitespace-nowrap px-4 py-3 text-right sm:px-6">
                                <div class="flex justify-end gap-2">
                                    <a asp-action="Edit" asp-route-id="@categoria.Id" class="btn-secondary">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@categoria.Id" class="btn-secondary text-red-600">Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
