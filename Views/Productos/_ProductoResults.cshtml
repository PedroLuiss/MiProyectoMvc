@model ProductoIndexViewModel

<div id="producto-resultados">
    <p class="mt-6 text-sm text-slate-500" data-product-count>
        @Model.Productos.Count producto(s) en el catálogo.
    </p>

    @if (Model.Productos.Count == 0)
    {
        <div class="mt-4 rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center">
            <p class="text-sm font-semibold text-slate-900">No hay productos para mostrar</p>
            <p class="mt-1 text-sm text-slate-500">
                @(Model.TieneFiltros
                    ? "Prueba con otro filtro o limpia la búsqueda."
                    : "Crea el primero para verlo en el catálogo.")
            </p>
            @if (Model.TieneFiltros)
            {
                <a asp-action="Index" class="btn-secondary mt-5">Limpiar filtros</a>
            }
            else
            {
                <a asp-action="Create" class="btn-primary mt-5">Crear producto</a>
            }
        </div>
    }
    else
    {
        <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var producto in Model.Productos)
            {
                <article class="group flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md"
                         data-product-card="@producto.Id">
                    <div class="relative aspect-4/3 overflow-hidden bg-slate-100">
                        <img src="@(producto.ImagenUrl ?? "/images/producto-placeholder.svg")"
                             alt="@producto.Nombre"
                             loading="lazy"
                             class="h-full w-full object-cover transition duration-300 group-hover:scale-105" />
                        <div class="absolute left-3 top-3 flex flex-wrap gap-2">
                            @if (!producto.Activo)
                            {
                                <span class="badge badge-danger">Inactivo</span>
                            }
                            <span data-out-of-stock
                                  class="badge badge-warning @(producto.Stock == 0 ? "" : "hidden")">
                                Agotado
                            </span>
                        </div>
                    </div>

                    <div class="flex flex-1 flex-col p-5">
                        <div class="flex items-center justify-between gap-2">
                            <span class="badge badge-brand">@producto.CategoriaNombre</span>
                            <span class="font-mono text-xs text-slate-400">@producto.Sku</span>
                        </div>

                        <h2 class="mt-3 line-clamp-2 text-base font-semibold text-slate-900">@producto.Nombre</h2>

                        @if (!string.IsNullOrWhiteSpace(producto.Marca))
                        {
                            <p class="mt-1 text-sm text-slate-500">@producto.Marca</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(producto.Descripcion))
                        {
                            <p class="mt-2 line-clamp-2 text-sm text-slate-500">@producto.Descripcion</p>
                        }

                        <div class="mt-auto pt-4">
                            <p class="text-lg font-bold text-slate-900">@producto.Precio.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("es-MX"))</p>
                            @await Html.PartialAsync("_ProductoStock", new ProductoStockViewModel
                            {
                                Id = producto.Id,
                                Nombre = producto.Nombre,
                                Stock = producto.Stock
                            })
                        </div>

                        <div class="mt-4 flex flex-wrap gap-2 border-t border-slate-100 pt-4">
                            <a asp-action="Details" asp-route-id="@producto.Id" class="btn-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@producto.Id" class="btn-secondary">Editar</a>
                            <form asp-action="Delete" asp-route-id="@producto.Id" method="post"
                                  data-ajax-delete class="ml-auto">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="categoriaId" value="@Model.CategoriaId" />
                                <input type="hidden" name="buscar" value="@Model.Buscar" />
                                <button type="submit"
                                        class="btn-secondary text-red-600 hover:text-red-700">
                                    Eliminar
                                </button>
                            </form>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>
