@model ProductoFormViewModel

@{
    var accion = ViewData["FormAction"] as string ?? "Create";
    var textoBoton = ViewData["SubmitLabel"] as string ?? "Guardar producto";
}

<div class="mx-auto max-w-5xl">
    <div class="mb-6">
        <a asp-action="Index" class="text-sm font-medium text-brand-600 transition hover:text-brand-700">← Volver al catálogo</a>
        <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-900">@ViewData["Title"]</h1>
        <p class="mt-1 text-sm text-slate-500">Completa los datos del producto y, si quieres, añade una foto.</p>
    </div>

    <form asp-action="@accion" method="post" enctype="multipart/form-data" class="grid gap-6 lg:grid-cols-3">
        <input type="hidden" asp-for="Id" />

        <div class="space-y-5 rounded-xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-2">
            <div asp-validation-summary="ModelOnly"></div>

            <div>
                <label asp-for="Nombre" class="label"></label>
                <input asp-for="Nombre" class="input-field" placeholder="Ej. Café molido 500 g" />
                <span asp-validation-for="Nombre"></span>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
                <div>
                    <label asp-for="Sku" class="label"></label>
                    <input asp-for="Sku" class="input-field" placeholder="CAF-500" />
                    <span asp-validation-for="Sku"></span>
                </div>
                <div>
                    <label asp-for="Marca" class="label"></label>
                    <input asp-for="Marca" class="input-field" placeholder="Ej. Nestlé" />
                    <span asp-validation-for="Marca"></span>
                </div>
            </div>

            <div>
                <label asp-for="Descripcion" class="label"></label>
                <textarea asp-for="Descripcion" rows="4" class="input-field"
                          placeholder="Descripción breve del producto, materiales o presentación"></textarea>
                <span asp-validation-for="Descripcion"></span>
            </div>

            <div class="grid gap-5 sm:grid-cols-3">
                <div>
                    <label asp-for="Precio" class="label"></label>
                    <input asp-for="Precio" type="number" step="0.01" min="0.01"
                           class="input-field" placeholder="0.00" />
                    <span asp-validation-for="Precio"></span>
                </div>
                <div>
                    <label asp-for="Stock" class="label"></label>
                    <input asp-for="Stock" class="input-field" placeholder="0" />
                    <span asp-validation-for="Stock"></span>
                </div>
                <div>
                    <label asp-for="CategoriaId" class="label"></label>
                    <select asp-for="CategoriaId" asp-items="Model.Categorias" class="input-field">
                        <option value="">Selecciona una categoría</option>
                    </select>
                    <span asp-validation-for="CategoriaId"></span>
                </div>
            </div>

            <label class="flex items-center gap-3 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3">
                <input asp-for="Activo" class="h-4 w-4 accent-brand-600" />
                <span class="text-sm font-medium text-slate-700">Producto activo</span>
            </label>
        </div>

        <aside class="space-y-4">
            <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-sm font-semibold text-slate-900">Foto del producto</p>

                <div class="mt-3 aspect-4/3 overflow-hidden rounded-lg bg-slate-100">
                    <img id="imagen-preview"
                         src="@(Model.ImagenUrl ?? "/images/producto-placeholder.svg")"
                         alt="Vista previa del producto"
                         class="h-full w-full object-cover" />
                </div>

                <input asp-for="Imagen" type="file" accept="image/jpeg,image/png,image/webp"
                       class="sr-only" data-image-input />
                <label for="Imagen" class="btn-secondary mt-4 w-full cursor-pointer">Seleccionar imagen</label>

                <p class="mt-2 text-xs text-slate-500">JPG, PNG o WebP. Máximo 2 MB.</p>
                <span asp-validation-for="Imagen"></span>
            </div>

            <div class="flex flex-col gap-2">
                <button type="submit" class="btn-primary">@textoBoton</button>
                <a asp-action="Index" class="btn-secondary">Cancelar</a>
            </div>
        </aside>
    </form>
</div>
