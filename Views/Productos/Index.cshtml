@model ProductoIndexViewModel

@{
    ViewData["Title"] = "Productos";
    var culture = System.Globalization.CultureInfo.GetCultureInfo("es-MX");
}

<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Productos</h1>
        <p class="mt-1 text-sm text-slate-500">
            @Model.Productos.Count producto(s) en el catálogo.
        </p>
    </div>
    <a asp-action="Create" class="btn-primary">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Nuevo producto
    </a>
</div>

@* Filtros por texto y categoria; el formulario viaja por GET en la URL. *@
<form method="get" asp-action="Index" class="mt-6 grid gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:grid-cols-[1fr_16rem_auto]">
    <div>
        <label for="buscar" class="sr-only">Buscar productos</label>
        <input id="buscar" name="buscar" value="@Model.Buscar" class="input-field"
               placeholder="Buscar por nombre, SKU o marca" />
    </div>
    <div>
        <label for="categoriaId" class="sr-only">Categoría</label>
        <select id="categoriaId" name="categoriaId" class="input-field">
            <option value="">Todas las categorías</option>
            @foreach (var categoria in Model.Categorias)
            {
                <option value="@categoria.Id" selected="@(Model.CategoriaId == categoria.Id)">@categoria.Nombre</option>
            }
        </select>
    </div>
    <div class="flex gap-2">
        <button type="submit" class="btn-primary flex-1">Filtrar</button>
        @if (Model.TieneFiltros)
        {
            <a asp-action="Index" class="btn-secondary">Limpiar</a>
        }
    </div>
</form>

@if (Model.Productos.Count == 0)
{
    <div class="mt-6 rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center">
        <p class="text-sm font-semibold text-slate-900">No hay productos para mostrar</p>
        <p class="mt-1 text-sm text-slate-500">
            @(Model.TieneFiltros
                ? "Prueba con otro filtro o limpia la búsqueda."
                : "Crea el primero para verlo en el catálogo.")
        </p>
        @if (Model.TieneFiltros)
        {
            <a asp-action="Index" class="btn-secondary mt-5">Limpiar filtros</a>
        }
        else
        {
            <a asp-action="Create" class="btn-primary mt-5">Crear producto</a>
        }
    </div>
}
else
{
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var producto in Model.Productos)
        {
            <article class="group flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md">
                <div class="relative aspect-4/3 overflow-hidden bg-slate-100">
                    <img src="@(producto.ImagenUrl ?? "/images/producto-placeholder.svg")"
                         alt="@producto.Nombre"
                         loading="lazy"
                         class="h-full w-full object-cover transition duration-300 group-hover:scale-105" />
                    <div class="absolute left-3 top-3 flex flex-wrap gap-2">
                        @if (!producto.Activo)
                        {
                            <span class="badge badge-danger">Inactivo</span>
                        }
                        @if (producto.Stock == 0)
                        {
                            <span class="badge badge-warning">Agotado</span>
                        }
                    </div>
                </div>

                <div class="flex flex-1 flex-col p-5">
                    <div class="flex items-center justify-between gap-2">
                        <span class="badge badge-brand">@producto.CategoriaNombre</span>
                        <span class="font-mono text-xs text-slate-400">@producto.Sku</span>
                    </div>

                    <h2 class="mt-3 line-clamp-2 text-base font-semibold text-slate-900">@producto.Nombre</h2>

                    @if (!string.IsNullOrWhiteSpace(producto.Marca))
                    {
                        <p class="mt-1 text-sm text-slate-500">@producto.Marca</p>
                    }

                    @if (!string.IsNullOrWhiteSpace(producto.Descripcion))
                    {
                        <p class="mt-2 line-clamp-2 text-sm text-slate-500">@producto.Descripcion</p>
                    }

                    <div class="mt-auto flex items-end justify-between gap-3 pt-4">
                        <div>
                            <p class="text-lg font-bold text-slate-900">@producto.Precio.ToString("C", culture)</p>
                            <p class="text-xs text-slate-400">Stock: @producto.Stock</p>
                        </div>
                        <div class="flex gap-2">
                            <a asp-action="Details" asp-route-id="@producto.Id" class="btn-secondary">Ver</a>
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>
}
