@model ProductoDetailsViewModel

@{
    ViewData["Title"] = "Eliminar producto";
    var culture = System.Globalization.CultureInfo.GetCultureInfo("es-MX");
}

<div class="mx-auto max-w-2xl">
    <div class="rounded-2xl border border-red-200 bg-white p-6 shadow-sm sm:p-8">
        <p class="text-sm font-semibold uppercase tracking-wide text-red-600">Eliminar producto</p>
        <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-900">¿Seguro que quieres eliminar este producto?</h1>
        <p class="mt-2 text-sm text-slate-600">Esta acción también elimina la foto asociada y no se puede deshacer.</p>

        <div class="mt-6 flex gap-4 rounded-xl border border-slate-200 bg-slate-50 p-4">
            <img src="@(Model.ImagenUrl ?? "/images/producto-placeholder.svg")"
                 alt="@Model.Nombre"
                 class="h-20 w-20 shrink-0 rounded-lg object-cover" />
            <div class="min-w-0">
                <p class="truncate font-semibold text-slate-900">@Model.Nombre</p>
                <p class="mt-1 text-sm text-slate-500">@Model.CategoriaNombre · @Model.Sku</p>
                <p class="mt-1 text-sm font-semibold text-slate-900">@Model.Precio.ToString("C", culture)</p>
            </div>
        </div>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-6 flex flex-wrap gap-3">
            <button type="submit" class="inline-flex items-center justify-center rounded-lg bg-red-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-red-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600">
                Sí, eliminar
            </button>
            <a asp-action="Index" class="btn-secondary">Cancelar</a>
        </form>
    </div>
</div>
