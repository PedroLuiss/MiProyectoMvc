@model ErrorViewModel
@* Esta vista recibe un modelo con un identificador de solicitud para diagnostico. *@
@{
    ViewData["Title"] = "Error";
}

@* Mensaje generico: no se muestran detalles internos de la excepcion al visitante. *@
<div class="mx-auto max-w-2xl rounded-2xl border border-red-200 bg-white p-8 shadow-sm">
    <p class="text-sm font-semibold uppercase tracking-wide text-red-600">Error</p>
    <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-900">Ocurrió un problema al procesar la solicitud.</h1>
    <p class="mt-3 text-sm leading-relaxed text-slate-600">
        Vuelve a intentarlo. Si el problema continúa, revisa los registros del servidor
        con el identificador de la solicitud.
    </p>

    @if (Model.ShowRequestId)
    {
        @* El ID ayuda al equipo tecnico a localizar la solicitud en los registros. *@
        <p class="mt-5 rounded-lg bg-slate-50 px-4 py-3 text-sm text-slate-600 ring-1 ring-inset ring-slate-200">
            <strong class="font-semibold text-slate-900">Request ID:</strong>
            <code class="ml-1 font-mono text-xs">@Model.RequestId</code>
        </p>
    }

    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn-primary mt-6">Volver al inicio</a>
</div>
